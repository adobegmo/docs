# Per-target secret + deploy source of truth for the edge worker.
#
# Copy this to a gitignored `.env.<env>.<site>` per target - env is test|prod, site
# is red|writing|… (e.g. .env.test.red, .env.test.writing; .env.prod.red later).
# Fill in the values, then push them with:  npm run secrets:<env>:<site>
# (scripts/set-secrets.sh packs these into the APP_SECRETS bundle and sets that
# target's DOCKET_SESSION_SECRET pipeline variable).
#
# WHY THIS FILE EXISTS: Cloud Manager will not let you read a secret back after
# setting it, but rebuilding the bundle to add or rotate any one value needs the
# CURRENT value of the others. This local file is that canonical record.
# NEVER commit a filled-in copy. Keep it off backups/sync.

# --- Cloud Manager targeting (from .aio.<name> + the config pipeline) ---
# PROGRAM_ID is in .aio.<name> (cloudmanager_programid). PIPELINE_ID is the Edge
# Delivery config pipeline id; find it with:
#   aio cloudmanager:list-pipelines --programId <PROGRAM_ID>
PROGRAM_ID=
PIPELINE_ID=

# --- Shared across sites WITHIN an environment (same value in every same-env file;
#     test and prod each get their own) ---
# HMAC key for the docket_session cookie. Self-generated, not from any service:
#   openssl rand -hex 32
# Rotating it logs every active session out (for that environment).
SESSION_SECRET=

# Confidential IMS client_credentials secret (Adobe Developer Console integration
# for IMS_CLIENT_ID in edgeFunctions.yaml). prod typically uses its own IMS client.
IMS_CLIENT_SECRET=

# --- PER SITE (different value for each site) ---
# aem.page/aem.live origin token for token-based Site Authentication, from:
#   POST admin.hlx.page/config/adobegmo/sites/<site>/secrets.json   (starts hlx_)
# Leave blank until you lock this site's origin.
ORIGIN_AUTHENTICATION=
